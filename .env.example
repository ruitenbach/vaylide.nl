# Vaylide: voorbeeldconfiguratie. Kopieer naar .env en vul aan.
# Zet NOOIT echte geheimen in GitHub; .env staat in .gitignore.

# --- Basis ---
# test = gesimuleerde betalingen, e-mails alleen bewaren, testbalk op iedere pagina.
# live = echte betaalprovider en e-mail vereist (de app weigert anders te starten).
VIERLIEF_MODE=test
DJANGO_DEBUG=true
# Lange willekeurige waarde, bijv.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.vaylide.nl
# Publiek adres (voor links in e-mails en QR-codes), zonder slash aan het eind.
VIERLIEF_BASE_URL=http://127.0.0.1:8000
VIERLIEF_CONTACT_EMAIL=hallo@vaylide.test
# Waar meldingen voor de eigenaar heen gaan (nieuwe wensen, storingen).
VIERLIEF_OWNER_EMAIL=hallo@vaylide.test

# --- Database ---
# Standaard SQLite in data/. Voor productie bij voorkeur PostgreSQL:
# DATABASE_URL=postgres://gebruiker:wachtwoord@host:5432/vaylide
# VIERLIEF_DATA_DIR=/var/lib/vaylide
# VIERLIEF_UPLOAD_DIR=/var/lib/vaylide/uploads

# --- E-mail ---
# outbox = alleen bewaren (testmodus), smtp = echt versturen.
VIERLIEF_EMAIL_MODE=outbox
# SMTP_HOST=mail.example.nl
# SMTP_PORT=465
# SMTP_USER=hallo@vaylide.nl
# SMTP_PASS=
# VIERLIEF_FROM_EMAIL=Vaylide <hallo@vaylide.nl>
# Naam en land van de e-maildienst voor de privacyverklaring (verplicht met smtp in live-modus):
# VIERLIEF_EMAIL_AANBIEDER=Naam B.V. (Nederland)
# Pas zetten als de eigenaar de nieuwe voorwaarden (16 oktober 2026) en de privacyverklaring definitief heeft goedgekeurd, en de datum waarop de nieuwe prijzen ingaan:
# VIERLIEF_TEKSTEN_DEFINITIEF=1
# VIERLIEF_ACTIVERINGSDATUM=2026-11-01

# --- Betalingen ---
# test = gesimuleerde betaalpagina (alleen in testmodus), mollie = Mollie (in testmodus alleen met een test_-sleutel).
VIERLIEF_PAYMENT_PROVIDER=test
# MOLLIE_API_KEY=test_...   (live: live_...)

# --- AI (optioneel) ---
# Zonder sleutel werkt alles in testmodus met vaste voorbeeldteksten.
# ANTHROPIC_API_KEY=
# VIERLIEF_AI_MODEL=claude-opus-5-5
# VIERLIEF_AI_ENABLED=true
# Met een sleutel: de afspraken met Anthropic over doorgifte buiten de EER, in één zin voor de privacyverklaring.
# VIERLIEF_AI_AFSPRAKEN=
# Tweede back-uplocatie (docs/BACKUP.md): naam en land van de aanbieder voor de privacyverklaring.
# VIERLIEF_BACKUP_AANBIEDER=

# --- Verwerking en beveiliging ---
# Taken direct proberen na betaling (aanbevolen). Herhalen via: python manage.py process_jobs
VIERLIEF_JOBS_INLINE=true
# Token voor een externe cron die /intern/taken/ aanroept (optioneel).
# VIERLIEF_CRON_TOKEN=
# Aantal vertrouwde proxy's vóór de app (1 bij de meeste hostingplatforms).
VIERLIEF_TRUSTED_PROXY_HOPS=0
# Blokkeer adressen die veel onbekende uitnodigingslinks proberen (pas aanzetten nadat de proxyketen is gemeten).
# VIERLIEF_LINKBLOKKADE=false
# Meetscherm voor de proxyketen in Beheer > Instellingen (alleen testmodus, daarna weer uit).
# VIERLIEF_IP_METING=false
# Pad van het noodbeheer (Django admin). Kies iets dat niet makkelijk te raden is.
VIERLIEF_DJANGO_ADMIN_PATH=systeembeheer/
# Optioneel: één wachtwoord voor de hele site. Zet dit aan zolang een testversie online staat:
# in testmodus staat de inlogcode op het scherm, dus zonder wachtwoord kan iedereen inloggen met elk
# e-mailadres. Bezoekers krijgen eerst het inlogvenster van de browser. Leeg = uit.
# VIERLIEF_PREVIEW_USER=voorbeeld
# VIERLIEF_PREVIEW_PASSWORD=
# Tijdelijk alleen de informatiepagina's open (home, ontwerpen, prijzen, voorwaarden, privacy, contact, voorbeelden),
# alleen bekijken; inloggen, maken, bestellen, uitnodigingen, beheer en formulieren blijven achter het wachtwoord.
# Bijvoorbeeld voor de websitecontrole door Mollie. Werkt alleen samen met VIERLIEF_PREVIEW_PASSWORD.
# VIERLIEF_PREVIEW_OPEN_PUBLIC=false

# Automatische aanbiedingen (docs/AANBIEDINGEN.md); standaard uit, los van de kortingscodes. Alleen met akkoord van de eigenaar aanzetten.
# VIERLIEF_AANBIEDINGEN=0

# Prijzenbeheer in Beheer (docs/PRIJZENBEHEER.md); standaard uit. Aan: de verkoopprijzen komen uit de database en de eigenaar past ze zelf aan.
# Alleen aanzetten na `python manage.py controleer_prijsbron` en met akkoord van de eigenaar.
# VIERLIEF_PRIJZENBEHEER=0

# Tweestapsverificatie voor Beheer en Django-admin (docs/TWEESTAPS.md). Geen echte sleutel in git.
# Sleutel maken: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Meerdere sleutels (komma): de eerste versleutelt, alle ontsleutelen. Zonder sleutel kan niemand 2FA instellen.
# VIERLIEF_2FA_SLEUTEL=
# Verplicht voor alle medewerkers; standaard uit. Pas aanzetten na bevestiging van de eigenaar en nadat 2FA is ingesteld.
# VIERLIEF_2FA_VERPLICHT=false

# --- Moments (in ontwikkeling) ---
# Standaard uit. Niet aanzetten zonder akkoord van de eigenaar.
# VIERLIEF_MOMENTS_ENABLED=false
# Opslag van Moments-foto's: "lokaal" (alleen testmodus, eigen map) of "s3" (aparte, privé TESTbucket; nooit de back-upbucket).
# VIERLIEF_MOMENTS_STORAGE=lokaal
# VIERLIEF_MOMENTS_S3_BUCKET=
# VIERLIEF_MOMENTS_S3_ENDPOINT=
# VIERLIEF_MOMENTS_S3_REGION=
# VIERLIEF_MOMENTS_S3_ACCESS_KEY=
# VIERLIEF_MOMENTS_S3_SECRET_KEY=
